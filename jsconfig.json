{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/utils/*": [
        "./utils/*"
      ],
      "@/context/*": [
        "./context/*"
      ],
      "@/layouts/*": [
        "./layouts/*"
      ],
      "@/styles/*": [
        "./styles/*"
      ],
      "@/public/*": [
        "./public/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.js",
    "**/*.js",
    "**/*.jsx",
    "utils/inventory.ts", "components/Image.jsx", "snippets/lambda.js", "app/page.jsx", "app/layout.jsx", "app/admin/page.jsx", "app/cart/page.jsx", "app/categories/page.jsx", "app/category/[name]/page.jsx", "app/checkout/page.jsx", "app/product/[name]/page.jsx", "app/product/[name]/ProductClient.jsx", "components/Button.jsx", "components/CartLink.jsx", "components/index.jsx", "components/Inventory.jsx", "components/ListItem.jsx", "components/QuantityPicker.jsx", "components/ViewInventory.jsx", "components/heroComponents/Center.jsx", "components/heroComponents/DisplayMedium.jsx", "components/heroComponents/DisplaySmall.jsx", "components/heroComponents/Footer.jsx", "components/heroComponents/Showcase.jsx", "components/heroComponents/Spacer.jsx", "components/heroComponents/Tag.jsx", "components/formComponents/AddInventory.jsx", "components/formComponents/ConfirmSignUp.jsx", "components/formComponents/SignIn.jsx", "components/formComponents/SignUp.jsx", "context/mainContext.jsx", "utils/categoryProvider.js", "utils/currencyProvider.ts", "utils/helpers.ts", "utils/inventoryByCategory.js", "utils/inventoryForCategory.js", "utils/inventoryProvider.js"  ],
  "exclude": [
    "node_modules"
  ]
}
